# Copie este arquivo para .env e troque todos os valores de exemplo.
# O .env nunca vai para o Git.

POSTGRES_USER=arno
POSTGRES_PASSWORD=defina-uma-senha-forte
POSTGRES_DB=tesouraria
POSTGRES_PORT=5434

DATABASE_URL=postgres://arno:defina-uma-senha-forte@127.0.0.1:5434/tesouraria

# Segredo dos tokens de sessão. Gere um valor aleatório, por exemplo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=defina-um-segredo-aleatorio-longo

PORT=4000

# Usuário e senha criados no primeiro start, quando o banco está vazio.
# Sem ADMIN_PASSWORD a API gera uma senha aleatória e imprime no console.
ADMIN_USER=tesouraria
ADMIN_PASSWORD=defina-uma-senha-forte

# Opcional: classifica linhas duvidosas do extrato (OpenAI-compatível)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# API Pix Sicredi (recebimentos em tempo real + conciliação)
# SICREDI_MOCK=1
# SICREDI_CLIENT_ID=
# SICREDI_CLIENT_SECRET=
# SICREDI_CERT_PATH=/caminho/certificado.pem
# SICREDI_KEY_PATH=/caminho/aplicacao.key
# SICREDI_CA_PATH=/caminho/CadeiaCompletaSicredi.pem
# SICREDI_PIX_KEY=
# SICREDI_API_BASE=https://api-pix.sicredi.com.br/api/v2
# SICREDI_OAUTH_URL=https://api-pix.sicredi.com.br/oauth/token
# PUBLIC_URL=https://tesouraria.seudominio.org
# SICREDI_WEBHOOK_TOKEN=um-segredo-longo-para-o-webhook

# WhatsApp Cloud API (webhook da Meta)
# URL no painel: https://tesouraria.seudominio.org/webhook
# Equivalente interno: /api/integrations/whatsapp/webhook
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_BUSINESS_ACCOUNT_ID=
# WHATSAPP_VERIFY_TOKEN=o-mesmo-segredo-do-painel-da-meta
# WHATSAPP_FINANCE_NUMBER=

# E-mail transacional (cobrança e comprovante)
# MAIL_MOCK=1
# MAIL_HOST=smtp.seudominio.org
# MAIL_PORT=587
# MAIL_USER=
# MAIL_PASS=
# MAIL_FROM="Tesouraria Arno <tesouraria@seudominio.org>"
# MAIL_SECURE=0
# MAIL_QUEUE_CONCURRENCY=3
# MAIL_QUEUE_MAX_ATTEMPTS=5
# MAIL_QUEUE_POLL_MS=1500
# MAIL_SEND_GAP_MS=150
