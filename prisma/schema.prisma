generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  username     String   @unique
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         String
  active       Boolean  @default(true)
  origin       String   @default("manual")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById  String?  @map("created_by") @db.Uuid
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedById  String?  @map("updated_by") @db.Uuid

  createdBy    User?  @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy    User?  @relation("UserUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdUsers User[] @relation("UserCreatedBy")
  updatedUsers User[] @relation("UserUpdatedBy")

  movementTypesCreated MovementType[]   @relation("MovementTypeCreatedBy")
  movementTypesUpdated MovementType[]   @relation("MovementTypeUpdatedBy")
  membersCreated       Member[]         @relation("MemberCreatedBy")
  membersUpdated       Member[]         @relation("MemberUpdatedBy")
  accountsCreated      MemberAccount[]  @relation("MemberAccountCreatedBy")
  accountsUpdated      MemberAccount[]  @relation("MemberAccountUpdatedBy")
  guardiansCreated     MemberGuardian[] @relation("MemberGuardianCreatedBy")
  guardiansUpdated     MemberGuardian[] @relation("MemberGuardianUpdatedBy")
  projectsCreated      Project[]        @relation("ProjectCreatedBy")
  projectsUpdated      Project[]        @relation("ProjectUpdatedBy")
  feesCreated          Fee[]            @relation("FeeCreatedBy")
  feesUpdated          Fee[]            @relation("FeeUpdatedBy")
  transactionsCreated  Transaction[]    @relation("TransactionCreatedBy")
  transactionsUpdated  Transaction[]    @relation("TransactionUpdatedBy")
  outboxCreated        MessageOutbox[]  @relation("OutboxCreatedBy")

  @@map("users")
}

model MovementType {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name        String    @unique
  direction   String
  description String    @default("")
  pixKey      String    @default("") @map("pix_key")
  branch      String    @default("grupo")
  active      Boolean   @default(true)
  origin      String    @default("manual")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById String?   @map("created_by") @db.Uuid
  updatedAt   DateTime? @map("updated_at") @db.Timestamptz(6)
  updatedById String?   @map("updated_by") @db.Uuid

  createdBy    User?         @relation("MovementTypeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy    User?         @relation("MovementTypeUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  transactions Transaction[]
  projectItems ProjectItem[]

  @@map("movement_types")
}

model Member {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name        String
  email       String    @unique
  phone       String
  branch      String
  role        String
  monthlyFee  Decimal   @default(0) @map("monthly_fee") @db.Decimal(12, 2)
  /** Valor fixo opcional (ex.: filho de chefe / irmão no grupo). Null = tabela oficial. */
  feeOverride Decimal?  @map("fee_override") @db.Decimal(12, 2)
  /** Filho de chefe — XOR com vínculos de irmão; aplica feeOverride = 82. */
  chiefChild  Boolean   @default(false) @map("chief_child")
  status      String    @default("active")
  joinedAt    DateTime  @map("joined_at") @db.Date
  clubeLtc    Boolean   @default(false) @map("clube_ltc")
  origin      String    @default("manual")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById String?   @map("created_by") @db.Uuid
  updatedAt   DateTime? @map("updated_at") @db.Timestamptz(6)
  updatedById String?   @map("updated_by") @db.Uuid

  createdBy    User?            @relation("MemberCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy    User?            @relation("MemberUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  accounts     MemberAccount[]
  guardians    MemberGuardian[]
  siblingsFrom MemberSibling[]  @relation("SiblingFrom")
  siblingsTo   MemberSibling[]  @relation("SiblingTo")
  transactions Transaction[]
  outbox       MessageOutbox[]

  @@index([joinedAt])
  @@map("members")
}

model MemberSibling {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  memberId    String   @map("member_id") @db.Uuid
  siblingId   String   @map("sibling_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById String?  @map("created_by") @db.Uuid

  member  Member @relation("SiblingFrom", fields: [memberId], references: [id], onDelete: Cascade)
  sibling Member @relation("SiblingTo", fields: [siblingId], references: [id], onDelete: Cascade)

  @@unique([memberId, siblingId])
  @@index([siblingId])
  @@map("member_siblings")
}

model MemberGuardian {
  id           String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  memberId     String    @map("member_id") @db.Uuid
  name         String
  relationship String
  phone        String    @default("")
  email        String    @default("")
  origin       String    @default("manual")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById  String?   @map("created_by") @db.Uuid
  updatedAt    DateTime? @map("updated_at") @db.Timestamptz(6)
  updatedById  String?   @map("updated_by") @db.Uuid

  member       Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdBy    User?         @relation("MemberGuardianCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy    User?         @relation("MemberGuardianUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  transactions Transaction[]

  @@index([memberId])
  @@map("member_guardians")
}

model MemberAccount {
  id            String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  memberId      String    @map("member_id") @db.Uuid
  holderName    String    @map("holder_name")
  holderKind    String    @map("holder_kind")
  relationship  String    @default("")
  pixKey        String    @default("") @map("pix_key")
  bank          String    @default("")
  agency        String    @default("")
  accountNumber String    @default("") @map("account_number")
  document      String    @default("")
  notes         String?
  isPrimary     Boolean   @default(false) @map("is_primary")
  active        Boolean   @default(true)
  origin        String    @default("manual")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById   String?   @map("created_by") @db.Uuid
  updatedAt     DateTime? @map("updated_at") @db.Timestamptz(6)
  updatedById   String?   @map("updated_by") @db.Uuid

  member       Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdBy    User?         @relation("MemberAccountCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy    User?         @relation("MemberAccountUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  transactions Transaction[]

  @@index([memberId])
  @@map("member_accounts")
}

model Project {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  branch      String
  year        Int
  name        String
  description String    @default("")
  origin      String    @default("manual")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById String?   @map("created_by") @db.Uuid
  updatedAt   DateTime? @map("updated_at") @db.Timestamptz(6)
  updatedById String?   @map("updated_by") @db.Uuid

  createdBy    User?         @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy    User?         @relation("ProjectUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  items        ProjectItem[]
  transactions Transaction[]

  @@map("projects")
}

model ProjectItem {
  id             String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  projectId      String  @map("project_id") @db.Uuid
  category       String
  description    String
  planned        Decimal @default(0) @db.Decimal(12, 2)
  movementTypeId String? @map("movement_type_id") @db.Uuid

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  movementType MovementType? @relation(fields: [movementTypeId], references: [id], onDelete: SetNull)

  @@map("project_items")
}

model Fee {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name        String    @unique
  amount      Decimal   @db.Decimal(12, 2)
  origin      String    @default("manual")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById String?   @map("created_by") @db.Uuid
  updatedAt   DateTime? @map("updated_at") @db.Timestamptz(6)
  updatedById String?   @map("updated_by") @db.Uuid

  createdBy User? @relation("FeeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User? @relation("FeeUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("fees")
}

model Transaction {
  id               String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  date             DateTime  @db.Date
  type             String
  nature           String
  movementTypeId   String    @map("movement_type_id") @db.Uuid
  description      String
  amount           Decimal   @db.Decimal(12, 2)
  branch           String
  method           String
  paymentStatus    String    @default("paid") @map("payment_status")
  paidAt           DateTime? @map("paid_at") @db.Date
  memberId         String?   @map("member_id") @db.Uuid
  memberAccountId  String?   @map("member_account_id") @db.Uuid
  memberGuardianId String?   @map("member_guardian_id") @db.Uuid
  projectId        String?   @map("project_id") @db.Uuid
  notes            String?
  externalId       String?   @unique @map("external_id")
  clubFeeIncluded  Boolean?  @map("club_fee_included")
  splitGroupId     String?   @map("split_group_id") @db.Uuid
  splitTotal       Decimal?  @map("split_total") @db.Decimal(12, 2)
  splitIndex       Int?      @map("split_index")
  splitCount       Int?      @map("split_count")
  origin           String    @default("manual")
  /** csv | pdf | sicredi — formato da integração que gerou o lançamento. */
  importSource     String?   @map("import_source")
  createdById      String?   @map("created_by") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime? @map("updated_at") @db.Timestamptz(6)
  updatedById      String?   @map("updated_by") @db.Uuid

  movementType   MovementType    @relation(fields: [movementTypeId], references: [id])
  member         Member?         @relation(fields: [memberId], references: [id], onDelete: SetNull)
  memberAccount  MemberAccount?  @relation(fields: [memberAccountId], references: [id], onDelete: SetNull)
  memberGuardian MemberGuardian? @relation(fields: [memberGuardianId], references: [id], onDelete: SetNull)
  project        Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy      User?           @relation("TransactionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy      User?           @relation("TransactionUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  outbox         MessageOutbox[]

  @@index([date])
  @@index([branch])
  @@index([movementTypeId])
  @@index([paymentStatus])
  @@index([memberGuardianId])
  @@index([splitGroupId])
  @@map("transactions")
}

model Settings {
  id                String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  openingBalance    Decimal @default(0) @map("opening_balance") @db.Decimal(12, 2)
  groupName         String  @map("group_name")
  mensalidadeDueDay Int     @default(10) @map("mensalidade_due_day")

  @@map("settings")
}

model BankMovement {
  id            String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  provider      String    @default("sicredi")
  externalId    String    @unique @map("external_id")
  occurredAt    DateTime  @map("occurred_at") @db.Timestamptz(6)
  date          DateTime  @db.Date
  amount        Decimal   @db.Decimal(12, 2)
  type          String
  method        String    @default("pix")
  description   String
  payerName     String    @default("") @map("payer_name")
  payerDocument String    @default("") @map("payer_document")
  txid          String    @default("")
  status        String    @default("new")
  transactionId String?   @map("transaction_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime? @map("updated_at") @db.Timestamptz(6)

  @@index([date, occurredAt])
  @@index([status])
  @@index([transactionId])
  @@map("bank_movements")
}

model BankSyncState {
  provider   String    @id
  lastSyncAt DateTime? @map("last_sync_at") @db.Timestamptz(6)
  lastError  String?   @map("last_error")
  lastFrom   DateTime? @map("last_from") @db.Date
  lastTo     DateTime? @map("last_to") @db.Date
  updatedAt  DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("bank_sync_state")
}

model MessageOutbox {
  id            String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  kind          String
  channel       String
  status        String
  memberId      String?   @map("member_id") @db.Uuid
  transactionId String?   @map("transaction_id") @db.Uuid
  toAddress     String    @map("to_address")
  subject       String    @default("")
  body          String
  htmlBody      String?   @map("html_body")
  error         String?
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  claimedAt     DateTime? @map("claimed_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  sentAt        DateTime? @map("sent_at") @db.Timestamptz(6)
  createdById   String?   @map("created_by") @db.Uuid

  member      Member?      @relation(fields: [memberId], references: [id], onDelete: SetNull)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  createdBy   User?        @relation("OutboxCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([transactionId])
  @@index([nextAttemptAt, createdAt])
  @@map("message_outbox")
}
